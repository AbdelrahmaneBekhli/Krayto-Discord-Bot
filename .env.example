# Copy to .env and fill in your bot token.
DISCORD_TOKEN=your-bot-token-here

# ---------------------------------------------------------------------------
# AI (optional). Without this the Mafia narrator uses its built-in script and
# everything else works exactly the same.
#
# Any provider that speaks the OpenAI chat-completions shape works. Groq is the
# recommended default: free tier, and fast enough that a night is written long
# before the night ends.
#
#   groq        https://console.groq.com/keys          free tier, fastest
#   openrouter  https://openrouter.ai/keys             many models, one key
#   openai      https://platform.openai.com/api-keys   paid
#   together    https://api.together.xyz/settings/api-keys
#   ollama      run it yourself, no key needed
# ---------------------------------------------------------------------------
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your-key-here

# Optional. Overrides the provider's default model.
# LLM_MODEL=llama-3.3-70b-versatile

# Optional. Only for something self-hosted or not in the list above.
# LLM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Night illustrations (optional, and off until you set this). One picture per
# Mafia night, posted as the closing beat of the story. Nothing is generated
# unless you name a provider here.
#
#   pollinations  no signup, no key, keyless GET       easiest
#   huggingface   https://huggingface.co/settings/tokens   better models
# ---------------------------------------------------------------------------
# IMAGE_PROVIDER=pollinations

# Needed for huggingface, ignored by pollinations.
# IMAGE_API_KEY=hf_your-token-here

# Optional. Overrides the provider's default model.
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
